/** YourDesignGPT visits. Isolated workbook; no DEA records or permissions. */
function ydgVisitsPrepare(){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const props=PropertiesService.getScriptProperties(),existing=props.getProperty('YDG_VISITS_SHEET_ID');if(existing){console.log(SpreadsheetApp.openById(existing).getUrl());return;}const book=SpreadsheetApp.create('YOURDESIGNGPT_CONTADOR_VISITAS');book.setSpreadsheetTimeZone('Europe/Madrid');const history=book.getSheets()[0];history.setName('HISTORICO');history.getRange(1,1,5,2).setValues([['fecha_madrid','visitas'],['2026-11-04',9],['2026-11-05',96],['2026-11-06',35],['2026-11-07',42]]);const events=book.insertSheet('REGISTROS');events.appendRow(['fecha_madrid','id_sesion_sha256','alta_utc']);const audit=book.insertSheet('MIGRACION');audit.appendRow(['fecha_utc','origen','visitas_importadas','criterio']);audit.appendRow([new Date().toISOString(),'Vercel Blob ydg-visitas/v1 · 04–07/11/2026',182,'Sesión de navegador por día Europe/Madrid']);[history,events,audit].forEach(sh=>{sh.setFrozenRows(1);sh.getRange(1,1,1,sh.getLastColumn()).setBackground('#11203d').setFontColor('#8ae7ff').setFontWeight('bold');sh.autoResizeColumns(1,sh.getLastColumn());});SpreadsheetApp.flush();props.setProperty('YDG_VISITS_SHEET_ID',book.getId());console.log(book.getUrl());}finally{lock.releaseLock();}}
function ydgVisitsBook_(){const id=PropertiesService.getScriptProperties().getProperty('YDG_VISITS_SHEET_ID');if(!id)throw Error('YDG no configurado');return SpreadsheetApp.openById(id);}
function ydgVisitsDay_(value){return value&&typeof value.getTime==='function'?Utilities.formatDate(value,'Europe/Madrid','yyyy-MM-dd'):String(value);}
function ydgVisitsState_(book,stats){const days={};let total=0;book.getSheetByName('HISTORICO').getDataRange().getValues().slice(1).forEach(r=>{const d=ydgVisitsDay_(r[0]),n=r[1];if(!/^\d{4}-\d{2}-\d{2}$/.test(d)||!Number.isSafeInteger(n)||n<0)throw Error('Histórico inválido');days[d]=(days[d]||0)+n;total+=n;});book.getSheetByName('REGISTROS').getDataRange().getValues().slice(1).forEach(r=>{const d=ydgVisitsDay_(r[0]);if(!/^\d{4}-\d{2}-\d{2}$/.test(d))throw Error('Fecha inválida');days[d]=(days[d]||0)+1;total++;});const today=Utilities.formatDate(new Date(),'Europe/Madrid','yyyy-MM-dd'),result={total:total,hoy:days[today]||0,fecha:today,zona:'Europe/Madrid',criterio:'Una visita por sesión de navegador',registroPausado:false};if(stats)result.historial=Object.keys(days).sort().map(d=>({fecha:d,visitas:days[d]}));return result;}
function ydgVisitsPublic_(p){let result;try{const token=String(p.session||'');if(token&&!/^[a-f0-9]{32}$/.test(token))throw Error('ID inválido');const lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('Contador ocupado');try{const book=ydgVisitsBook_();let registered=false;if(token){const day=Utilities.formatDate(new Date(),'Europe/Madrid','yyyy-MM-dd'),hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join(''),sh=book.getSheetByName('REGISTROS');const exists=sh.getDataRange().getValues().slice(1).some(r=>ydgVisitsDay_(r[0])===day&&r[1]===hash);if(!exists){sh.appendRow([day,hash,new Date().toISOString()]);SpreadsheetApp.flush();registered=true;}}result=ydgVisitsState_(book,p.stats==='1');if(token)result.registrada=registered;}finally{lock.releaseLock();}}catch(e){result={error:'No se pudieron consultar las visitas'};}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);}
