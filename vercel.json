{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "yourdesigngpt.vercel.app"
        }
      ],
      "destination": "https://yourdesigngpt.es/:path*",
      "permanent": true
    },
    {
      "source": "/admin/captacion/:path*",
      "destination": "https://leads-yourdesigngpt.vercel.app/admin/captacion/:path*",
      "permanent": false
    }
  ]
}
